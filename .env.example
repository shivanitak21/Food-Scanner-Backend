# Copy to .env and replace every placeholder. Never put these values in the Expo app.
# The mobile app only needs EXPO_PUBLIC_API_URL.

NODE_ENV=development
PORT=8000
HOST=0.0.0.0
TRUST_PROXY=false

# Local MongoDB. Use your own Atlas URI here, not in the React Native app.
MONGODB_URI=mongodb://127.0.0.1:27017/foodlens

# At least 32 characters. Generate a unique value per environment.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma-separated browser origins. Native Expo requests have no Origin and are allowed.
# Use * only in development. Production refuses * .
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

LOG_LEVEL=info
BODY_LIMIT=1mb

# Open Food Facts requires a descriptive User-Agent.
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=FoodLens/1.0 (contact@example.com)
PRODUCT_CACHE_TTL_HOURS=168

# Optional. Barcode scans work without this. Label photos require it.
# Leave the key empty until you are ready. It stays on the server.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_VISION_MODEL=gpt-4o-mini
AI_EXPLANATION_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
